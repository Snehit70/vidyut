#!/usr/bin/env bash
set -euo pipefail

relay="${VIDYUT_RELAY_BIN:-$HOME/.local/bin/vidyut-relay}"
if [[ ! -x "$relay" ]]; then
  relay="$(command -v vidyut-relay || true)"
fi
if [[ -z "$relay" || ! -x "$relay" ]]; then
  notify-send "Vidyut" "The Vidyut relay is not installed."
  exit 1
fi

files=("$@")
if [[ ${#files[@]} -eq 0 ]]; then
  selection="$(zenity --file-selection --multiple --separator=$'\n' \
    --title='Send files with Vidyut' 2>/dev/null || true)"
  [[ -n "$selection" ]] || exit 0
  mapfile -t files <<<"$selection"
fi

args=()
for file in "${files[@]}"; do
  [[ -f "$file" ]] || continue
  args+=(--send "$file")
done
[[ ${#args[@]} -gt 0 ]] || exit 0

if output="$("$relay" "${args[@]}" 2>&1)"; then
  notify-send "Vidyut" "$output"
else
  notify-send -u critical "Vidyut file transfer failed" "$output"
  exit 1
fi
