#!/usr/bin/env bash
set -euo pipefail

bin_dir="${XDG_BIN_HOME:-$HOME/.local/bin}"
relay="${VIDYUT_RELAY_BIN:-$bin_dir/vidyut-relay}"
if [[ ! -x "$relay" ]]; then
  relay="$(command -v vidyut-relay || true)"
fi
if [[ -z "$relay" || ! -x "$relay" ]]; then
  notify-send "Vidyut" "The Vidyut relay is not installed." || true
  exit 1
fi

files=("$@")
if [[ ${#files[@]} -eq 0 ]]; then
  shell="${VIDYUT_SHELL_BIN:-$bin_dir/vidyut-shell}"
  if [[ ! -x "$shell" ]]; then
    shell="$(command -v vidyut-shell || true)"
  fi
  if [[ -n "$shell" && -x "$shell" ]]; then
    exec "$shell"
  fi
  notify-send "Vidyut" "Open the Vidyut desktop shell to send files." || true
  exit 1
fi

args=()
for file in "${files[@]}"; do
  [[ -f "$file" ]] || continue
  args+=(--send "$file")
done
[[ ${#args[@]} -gt 0 ]] || exit 0

if output="$("$relay" "${args[@]}" 2>&1)"; then
  notify-send "Vidyut" "$output" || true
else
  notify-send -u critical "Vidyut file transfer failed" "$output" || true
  exit 1
fi
