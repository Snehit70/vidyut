#!/usr/bin/env bash
set -euo pipefail

bin_dir="${XDG_BIN_HOME:-$HOME/.local/bin}"
shell="${VIDYUT_SHELL_BIN:-$bin_dir/vidyut-shell}"
if [[ ! -x "$shell" ]]; then
  shell="$(command -v vidyut-shell || true)"
fi
if [[ -n "$shell" && -x "$shell" ]]; then
  exec "$shell"
fi

relay="${VIDYUT_RELAY_BIN:-$bin_dir/vidyut-relay}"
if [[ ! -x "$relay" ]]; then
  relay="$(command -v vidyut-relay || true)"
fi
if [[ -z "$relay" || ! -x "$relay" ]]; then
  echo "Open the Vidyut desktop shell for Transfer history." >&2
  exit 1
fi
exec "$relay" --transfers
