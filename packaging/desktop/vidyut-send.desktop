# Do not add MimeType. Type=Application plus MimeType registers this as a
# default opener, so Enter / xdg-open in file managers (Yazi, Dolphin) send
# the file instead of opening it. Send stays on the KDE service menu and
# the Nautilus script.
[Desktop Entry]
Type=Application
Name=Send with Vidyut
Comment=Send selected files to your paired phone
Icon=folder-send-symbolic
Exec=@VIDYUT_BIN_DIR@/vidyut-send %F
Terminal=false
NoDisplay=true
