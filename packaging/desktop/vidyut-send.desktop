[Desktop Entry]
Type=Application
Name=Send with Vidyut
Comment=Send selected files to your paired phone
Icon=folder-send-symbolic
Exec=@VIDYUT_BIN_DIR@/vidyut-send %F
Terminal=false
MimeType=application/octet-stream;application/pdf;application/zip;application/gzip;text/plain;text/csv;image/png;image/jpeg;image/gif;image/webp;audio/mpeg;audio/ogg;video/mp4;video/webm;
NoDisplay=true
