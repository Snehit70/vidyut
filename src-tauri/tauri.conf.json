{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vidyut",
  "version": "1.11.2",
  "identifier": "dev.vidyut.shell",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vidyut",
        "url": "index.html",
        "width": 520,
        "height": 860,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
